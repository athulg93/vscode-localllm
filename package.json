{
  "name": "local-ollama-chat",
  "displayName": "Local Ollama Chat",
  "description": "Connect VS Code chat to a local Ollama instance and choose from your local models.",
  "version": "1.3.0",
  "publisher": "agovind",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/athulg93/vscode-localllm.git"
  },
  "private": true,
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onChatParticipant:local-ollama.participant"
  ],
  "contributes": {
    "commands": [
      {
        "command": "localOllama.connect",
        "title": "Local Ollama: Connect"
      },
      {
        "command": "localOllama.selectModel",
        "title": "Local Ollama: Select Model"
      },
      {
        "command": "localOllama.changeModel",
        "title": "Local Ollama: Change Model"
      },
      {
        "command": "localOllama.listModels",
        "title": "Local Ollama: List Models"
      },
      {
        "command": "localOllama.applySuggestedEdit",
        "title": "Local Ollama: Apply Suggested Edit"
      },
      {
        "command": "localOllama.refactorProject",
        "title": "Local Ollama: Refactor Project"
      },
      {
        "command": "localOllama.updateFromWorkspace",
        "title": "Local Ollama: Update From Workspace"
      },
      {
        "command": "localOllama.update",
        "title": "Local Ollama: Check for Updates"
      },
      {
        "command": "localOllama.openActivityLog",
        "title": "Local Ollama: Open Activity Log"
      }
    ],
    "configuration": {
      "title": "Local Ollama",
      "properties": {
        "localOllama.baseUrl": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Base URL for your local Ollama instance."
        },
        "localOllama.defaultModel": {
          "type": "string",
          "default": "qwen2.5-coder:7b",
          "description": "Default local model to use for chat prompts."
        },
        "localOllama.temperature": {
          "type": "number",
          "default": 0.7,
          "minimum": 0,
          "maximum": 1,
          "description": "Temperature passed to Ollama generation requests."
        },
        "localOllama.autoCreateDirectories": {
          "type": "boolean",
          "default": true,
          "description": "Automatically create missing folders for AI-proposed create/rename operations inside the workspace."
        },
        "localOllama.maxToolCalls": {
          "type": "number",
          "default": 16,
          "minimum": 4,
          "maximum": 40,
          "description": "Maximum workspace exploration operations allowed for one chat request."
        }
      }
    },
    "chatParticipants": [
      {
        "id": "local-ollama.participant",
        "name": "local-ollama",
        "fullName": "Local Ollama",
        "description": "Chat with your local Ollama agent in VS Code.",
        "commands": [
          {
            "name": "models",
            "description": "List available local Ollama models"
          },
          {
            "name": "connect",
            "description": "Configure base URL and default model"
          },
          {
            "name": "change-model",
            "description": "List local models and change the active default model"
          },
          {
            "name": "edit",
            "description": "Propose file edits, then apply or discard"
          },
          {
            "name": "refactor",
            "description": "Propose project refactor edits, then apply or discard"
          },
          {
            "name": "update",
            "description": "Check GitHub Releases for a newer extension version"
          }
        ],
        "isSticky": true
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "package": "vsce package",
    "test": "tsx --test src/core/**/*.test.ts",
    "lint": "eslint .",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.14.1",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^10.10.0",
    "tsx": "^4.23.13",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.70.0"
  }
}
